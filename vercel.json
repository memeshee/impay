{
  "rewrites": [
    {
      "source": "/i/:path*",
      "destination": "https://arabia-lexington-combination-beer.trycloudflare.com/i/:path*"
    },
    {
      "source": "/proof",
      "destination": "https://arabia-lexington-combination-beer.trycloudflare.com/proof"
    },
    {
      "source": "/api/:path*",
      "destination": "https://arabia-lexington-combination-beer.trycloudflare.com/api/:path*"
    },
    {
      "source": "/agent.json",
      "destination": "https://arabia-lexington-combination-beer.trycloudflare.com/agent.json"
    },
    {
      "source": "/health",
      "destination": "https://arabia-lexington-combination-beer.trycloudflare.com/health"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
