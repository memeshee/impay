{
  "rewrites": [
    {
      "source": "/i/:path*",
      "destination": "https://thee-features-auburn-proprietary.trycloudflare.com/i/:path*"
    },
    {
      "source": "/proof",
      "destination": "https://thee-features-auburn-proprietary.trycloudflare.com/proof"
    },
    {
      "source": "/api/:path*",
      "destination": "https://thee-features-auburn-proprietary.trycloudflare.com/api/:path*"
    },
    {
      "source": "/agent.json",
      "destination": "https://thee-features-auburn-proprietary.trycloudflare.com/agent.json"
    },
    {
      "source": "/health",
      "destination": "https://thee-features-auburn-proprietary.trycloudflare.com/health"
    }
  ],
  "headers": [
    {
      "source": "/agent.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
